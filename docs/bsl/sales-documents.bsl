// Обработчик GET /sales-documents
//
// ПРИМЕЧАНИЕ: вспомогательные функции, которые лежат в модуле HTTP-сервиса
// (Module.bsl) и нужны этому обработчику: ОтветJSON, ОтветОшибка, ПараметрыИзQuery.
// Прикладную логику обработчик берёт из общего модуля MCPBusinessFacade,
// который поставляется в расширении вместе с HTTP-сервисом.

Функция РеализацииGET(Запрос)
    Параметры = ПараметрыИзQuery(Запрос);
    Попытка
        Результат = MCPBusinessFacade.ПрочитатьДокументыПродаж(Параметры, "Документ.РеализацияТоваровУслуг", "documents");
    Исключение
        Возврат ОтветОшибка(400, ОписаниеОшибки());
    КонецПопытки;
    Возврат ОтветJSON(Результат);
КонецФункции
