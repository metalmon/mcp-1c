// Обработчик POST /document-attachment-metadata
//
// ПРИМЕЧАНИЕ: вспомогательные функции, которые лежат в модуле HTTP-сервиса
// (Module.bsl) и нужны этому обработчику: ОтветJSON, ОтветОшибка, РазобратьJSON.
// Прикладную логику обработчик берёт из общего модуля MCPBusinessFacade,
// который поставляется в расширении вместе с HTTP-сервисом.

Функция МетаданныеВложенияДокументаPOST(Запрос)
	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
	Параметры = Неопределено;
	ОшибкаРазбора = "";
	Попытка
	    Параметры = РазобратьJSON(ТелоЗапроса);
	Исключение
	    ОшибкаРазбора = ОписаниеОшибки();
	КонецПопытки;
	Если ЗначениеЗаполнено(ОшибкаРазбора) Тогда
	    Возврат ОтветОшибка(400, "request body is not valid JSON: " + ОшибкаРазбора);
	КонецЕсли;
	Если Параметры = Неопределено Тогда
		Возврат ОтветОшибка(400, "Invalid request body");
	КонецЕсли;

	Попытка
		РезультатИзменения = MCPBusinessFacade.ОбновитьМетаданныеВложенияДокумента(Параметры);
	Исключение
		Возврат ОтветОшибка(400, ОписаниеОшибки());
	КонецПопытки;
	Возврат ОтветJSON(РезультатИзменения);
КонецФункции
