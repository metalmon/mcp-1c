Функция ПрочитатьДокументыПродаж(Параметры, ИмяТаблицыДокумента, ИмяМассиваВОтвете) Экспорт
	Лимит = НормализоватьЛимит(Параметры, 50, 500);
	ЗапросСписка = Новый Запрос;
	ЗапросСписка.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ref,
	|	Док.Номер КАК Number,
	|	Док.Дата КАК Date,
	|	Док.Проведен КАК Posted
	|ИЗ
	|	" + ИмяТаблицыДокумента + " КАК Док
	|УПОРЯДОЧИТЬ ПО Док.Дата УБЫВ";
	Выборка = ЗапросСписка.Выполнить().Выбрать();

	МассивДокументов = Новый Массив;
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Если Счетчик = Лимит Тогда
			Прервать;
		КонецЕсли;
		Стр = Новый Структура;
		Стр.Вставить("ref", СсылкаВUUIDСтроку(Выборка.Ref));
		Стр.Вставить("number", Строка(Выборка.Number));
		Стр.Вставить("date", Строка(Выборка.Date));
		Стр.Вставить("posted", Выборка.Posted);
		МассивДокументов.Добавить(Стр);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить(ИмяМассиваВОтвете, МассивДокументов);
	Результат.Вставить("total", МассивДокументов.Количество());
	Результат.Вставить("truncated", Ложь);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьСправочник(ИмяТаблицы, ИмяМассива, Параметры, ИмяПоляСортировки, ДопПоля)
	Лимит = НормализоватьЛимит(Параметры, 50, 500);
	ЗапросСписка = Новый Запрос;
	ЗапросСписка.Текст =
	"ВЫБРАТЬ
	|	Ссылка КАК Ref,
	|	Код КАК Code,
	|	Наименование КАК Name
	|ИЗ
	|	" + ИмяТаблицы + "
	|УПОРЯДОЧИТЬ ПО " + ИмяПоляСортировки;
	Выборка = ЗапросСписка.Выполнить().Выбрать();

	Коллекция = Новый Массив;
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Если Счетчик = Лимит Тогда
			Прервать;
		КонецЕсли;
		Стр = Новый Структура;
		Стр.Вставить("ref", СсылкаВUUIDСтроку(Выборка.Ref));
		Стр.Вставить("code", Строка(Выборка.Code));
		Стр.Вставить("name", Строка(Выборка.Name));
		Коллекция.Добавить(Стр);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить(ИмяМассива, Коллекция);
	Результат.Вставить("total", Коллекция.Количество());
	Результат.Вставить("truncated", Ложь);
	Возврат Результат;
КонецФункции

Функция НормализоватьЛимит(Параметры, ЗначениеПоУмолчанию, Максимум)
	Лимит = ЗначениеПоУмолчанию;
	Если Параметры.Свойство("limit") Тогда
		Попытка
			Лимит = Число(Параметры.limit);
		Исключение
			Лимит = ЗначениеПоУмолчанию;
		КонецПопытки;
	КонецЕсли;
	Если Лимит <= 0 Тогда
		Лимит = ЗначениеПоУмолчанию;
	ИначеЕсли Лимит > Максимум Тогда
		Лимит = Максимум;
	КонецЕсли;
	Возврат Лимит;
КонецФункции

Функция UUIDИзСтроки(ЗначениеUUID)
	Попытка
		Возврат Новый УникальныйИдентификатор(Строка(ЗначениеUUID));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ДатаИзСтроки(ЗначениеДаты)
	Попытка
		Возврат XMLЗначение(Тип("Дата"), ЗначениеДаты);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция СсылкаВUUIDСтроку(Ссылка)
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Строка(Ссылка.УникальныйИдентификатор());
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Процедура ПроверитьСуществованиеСсылки(Ссылка, ИмяПоля)
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение ИмяПоля + " is empty";
	КонецЕсли;
	Попытка
		ОбъектСсылки = Ссылка.ПолучитьОбъект();
		Если ОбъектСсылки = Неопределено Тогда
			ВызватьИсключение ИмяПоля + " not found";
		КонецЕсли;
		Попытка
			Если ОбъектСсылки.ПометкаУдаления Тогда
				ВызватьИсключение ИмяПоля + " points to deleted object";
			КонецЕсли;
		Исключение
		КонецПопытки;
	Исключение
		ВызватьИсключение ИмяПоля + " not found";
	КонецПопытки;
КонецПроцедуры

Функция ДанныеСсылкиДляJSON(Ссылка)
	Объект = Ссылка.ПолучитьОбъект();
	Данные = Новый Структура;
	Данные.Вставить("ref", СсылкаВUUIDСтроку(Ссылка));
	Код = "";
	Наименование = "";
	Попытка
		Код = Объект.Код;
	Исключение
	КонецПопытки;
	Попытка
		Наименование = Объект.Наименование;
	Исключение
	КонецПопытки;
	Данные.Вставить("code", Код);
	Данные.Вставить("name", Наименование);
	Возврат Данные;
КонецФункции

Функция ПолучитьСсылкуДокументаПродаж(ТипДокумента, RefСтрока)
	Если ТипДокумента = "СчетНаОплатуПокупателю" Тогда
		Возврат Документы.СчетНаОплатуПокупателю.ПолучитьСсылку(UUIDИзСтроки(RefСтрока));
	КонецЕсли;
	Возврат Документы.РеализацияТоваровУслуг.ПолучитьСсылку(UUIDИзСтроки(RefСтрока));
КонецФункции

Процедура ЗаполнитьТоварыДокументаПродаж(Док, Параметры, Пост, ЗаменитьСуществующие)
	Если Пост И (НЕ Параметры.Свойство("items") ИЛИ ТипЗнч(Параметры.items) <> Тип("Массив") ИЛИ Параметры.items.Количество() = 0) Тогда
		Если НЕ ЗаменитьСуществующие ИЛИ Док.Товары.Количество() = 0 Тогда
			ВызватьИсключение "items are required when post=true";
		КонецЕсли;
	КонецЕсли;

	Если Параметры.Свойство("items") И ТипЗнч(Параметры.items) = Тип("Массив") Тогда
		Если ЗаменитьСуществующие Тогда
			Док.Товары.Очистить();
		КонецЕсли;
		НомерСтроки = 0;
		Для Каждого СтрТов Из Параметры.items Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НЕ СтрТов.Свойство("nomenclature_ref") Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].nomenclature_ref is required";
			КонецЕсли;
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(UUIDИзСтроки(СтрТов.nomenclature_ref));
			Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].nomenclature_ref not found";
			КонецЕсли;
			ПроверитьСуществованиеСсылки(Номенклатура, "items[" + Строка(НомерСтроки) + "].nomenclature_ref");
			СтрокаТЧ = Док.Товары.Добавить();
			СтрокаТЧ.Номенклатура = Номенклатура;
			Если Пост И НЕ СтрТов.Свойство("quantity") Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].quantity is required when post=true";
			КонецЕсли;
			Если Пост И НЕ СтрТов.Свойство("price") Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].price is required when post=true";
			КонецЕсли;
			Если СтрТов.Свойство("quantity") Тогда СтрокаТЧ.Количество = Число(СтрТов.quantity); Иначе СтрокаТЧ.Количество = 1; КонецЕсли;
			Если СтрТов.Свойство("price") Тогда СтрокаТЧ.Цена = Число(СтрТов.price); КонецЕсли;
			Если Пост И СтрокаТЧ.Количество <= 0 Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].quantity must be > 0 when post=true";
			КонецЕсли;
			Если Пост И СтрокаТЧ.Цена <= 0 Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].price must be > 0 when post=true";
			КонецЕсли;
			Попытка
				ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТЧ, Док, "Товары", Док.Метаданные());
			Исключение
			КонецПопытки;
			Если НЕ СтрТов.Свойство("quantity") Тогда
				СтрокаТЧ.Количество = 1;
			КонецЕсли;
			ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуТабЧасти(СтрокаТЧ);
			ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтрокаТЧ, Док.СуммаВключаетНДС);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
