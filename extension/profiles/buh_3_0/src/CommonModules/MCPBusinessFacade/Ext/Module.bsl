#Область ПрограммныйИнтерфейс

Функция СоздатьДокументПродаж(Параметры, ТипДокумента) Экспорт
	Если НЕ Параметры.Свойство("organization_ref") ИЛИ НЕ Параметры.Свойство("counterparty_ref") Тогда
		ВызватьИсключение "organization_ref and counterparty_ref are required";
	КонецЕсли;

	Организация = Справочники.Организации.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.organization_ref));
	Контрагент = Справочники.Контрагенты.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.counterparty_ref));
	Если НЕ ЗначениеЗаполнено(Организация) ИЛИ НЕ ЗначениеЗаполнено(Контрагент) Тогда
		ВызватьИсключение "organization_ref or counterparty_ref not found";
	КонецЕсли;
	ПроверитьСуществованиеСсылки(Организация, "organization_ref");
	ПроверитьСуществованиеСсылки(Контрагент, "counterparty_ref");

	Если ТипДокумента = "СчетНаОплатуПокупателю" Тогда
		Док = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
	Иначе
		Док = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		Док.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.Товары;
	КонецЕсли;

	ДанныеЗаполненияДок = Новый Структура;
	ДанныеЗаполненияДок.Вставить("Организация", Организация);
	ДанныеЗаполненияДок.Вставить("Контрагент", Контрагент);
	Док.Дата = ?(Параметры.Свойство("date"), ДатаИзСтроки(Строка(Параметры.date)), ТекущаяДата());
	Если НЕ ЗначениеЗаполнено(Док.Дата) Тогда
		Док.Дата = ТекущаяДата();
	КонецЕсли;
	ДанныеЗаполненияДок.Вставить("Дата", Док.Дата);

	Если Параметры.Свойство("contract_ref") И ЗначениеЗаполнено(Параметры.contract_ref) Тогда
		ДоговорСсылка = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.contract_ref));
		Если ЗначениеЗаполнено(ДоговорСсылка) Тогда
			ПроверитьСуществованиеСсылки(ДоговорСсылка, "contract_ref");
			ДанныеЗаполненияДок.Вставить("ДоговорКонтрагента", ДоговорСсылка);
		Иначе
			ВызватьИсключение "contract_ref not found";
		КонецЕсли;
	КонецЕсли;

	Док.Заполнить(ДанныеЗаполненияДок);

	Если НЕ ЗначениеЗаполнено(Док.ДоговорКонтрагента) Тогда
		Док.ДоговорКонтрагента = РаботаСДоговорамиКонтрагентовБП.ДоговорКонтрагентаИзОбъекта(Док);
	КонецЕсли;

	Если ТипДокумента = "РеализацияТоваровУслуг" И Параметры.Свойство("invoice_ref") И ЗначениеЗаполнено(Параметры.invoice_ref) Тогда
		СчетНаОплатуСсылка = Документы.СчетНаОплатуПокупателю.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.invoice_ref));
		Если НЕ ЗначениеЗаполнено(СчетНаОплатуСсылка) Тогда
			ВызватьИсключение "invoice_ref not found";
		КонецЕсли;
		ПроверитьСуществованиеСсылки(СчетНаОплатуСсылка, "invoice_ref");
		Док.СчетНаОплатуПокупателю = СчетНаОплатуСсылка;
	КонецЕсли;

	Пост = Ложь;
	Если Параметры.Свойство("post") Тогда Пост = Булево(Параметры.post); КонецЕсли;

	ЗаполнитьТоварыДокументаПродаж(Док, Параметры, Пост, Ложь);
	Если ТипДокумента = "РеализацияТоваровУслуг" Тогда
		// Используем только типовые процедуры БП для подготовки перед записью/проведением.
		Документы.РеализацияТоваровУслуг.ЗаполнитьСчетаУчетаРасчетов(Док);
		Документы.РеализацияТоваровУслуг.ЗаполнитьСчетаУчетаВТабличнойЧасти(Док, "Товары");
	КонецЕсли;
	Если Пост Тогда
		Док.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		Док.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ref", СтрокаТипизированнойСсылки(Док.Ссылка));
	Возврат Результат;
КонецФункции

Функция ОбновитьДокументПродаж(Параметры, ТипДокумента) Экспорт
	Если НЕ Параметры.Свойство("ref") Тогда
		ВызватьИсключение "ref is required";
	КонецЕсли;

	ДокСсылка = ПолучитьСсылкуДокументаПродаж(ТипДокумента, Параметры.ref);
	ПроверитьСуществованиеСсылки(ДокСсылка, "ref");
	Док = ДокСсылка.ПолучитьОбъект();

	Пост = Док.Проведен;
	Если Параметры.Свойство("post") Тогда
		Пост = Булево(Параметры.post);
	КонецЕсли;

	Если Параметры.Свойство("organization_ref") И ЗначениеЗаполнено(Параметры.organization_ref) Тогда
		Организация = Справочники.Организации.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.organization_ref));
		Если НЕ ЗначениеЗаполнено(Организация) Тогда
			ВызватьИсключение "organization_ref not found";
		КонецЕсли;
		ПроверитьСуществованиеСсылки(Организация, "organization_ref");
		Док.Организация = Организация;
	КонецЕсли;

	Если Параметры.Свойство("counterparty_ref") И ЗначениеЗаполнено(Параметры.counterparty_ref) Тогда
		Контрагент = Справочники.Контрагенты.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.counterparty_ref));
		Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
			ВызватьИсключение "counterparty_ref not found";
		КонецЕсли;
		ПроверитьСуществованиеСсылки(Контрагент, "counterparty_ref");
		Док.Контрагент = Контрагент;
	КонецЕсли;

	Если Параметры.Свойство("contract_ref") И ЗначениеЗаполнено(Параметры.contract_ref) Тогда
		ДоговорСсылка = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.contract_ref));
		Если НЕ ЗначениеЗаполнено(ДоговорСсылка) Тогда
			ВызватьИсключение "contract_ref not found";
		КонецЕсли;
		ПроверитьСуществованиеСсылки(ДоговорСсылка, "contract_ref");
		Док.ДоговорКонтрагента = ДоговорСсылка;
	КонецЕсли;

	Если ТипДокумента = "РеализацияТоваровУслуг" И Параметры.Свойство("invoice_ref") И ЗначениеЗаполнено(Параметры.invoice_ref) Тогда
		СчетНаОплатуСсылка = Документы.СчетНаОплатуПокупателю.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.invoice_ref));
		Если НЕ ЗначениеЗаполнено(СчетНаОплатуСсылка) Тогда
			ВызватьИсключение "invoice_ref not found";
		КонецЕсли;
		ПроверитьСуществованиеСсылки(СчетНаОплатуСсылка, "invoice_ref");
		Док.СчетНаОплатуПокупателю = СчетНаОплатуСсылка;
	КонецЕсли;

	Если Параметры.Свойство("date") Тогда
		НоваяДата = ДатаИзСтроки(Строка(Параметры.date));
		Если НЕ ЗначениеЗаполнено(НоваяДата) Тогда
			ВызватьИсключение "date is invalid";
		КонецЕсли;
		Док.Дата = НоваяДата;
	КонецЕсли;

	Если Параметры.Свойство("comment") Тогда
		Док.Комментарий = Строка(Параметры.comment);
	КонецЕсли;

	ЗаполнитьТоварыДокументаПродаж(Док, Параметры, Пост, Истина);

	Если ТипДокумента = "РеализацияТоваровУслуг" Тогда
		Документы.РеализацияТоваровУслуг.ЗаполнитьСчетаУчетаРасчетов(Док);
		Документы.РеализацияТоваровУслуг.ЗаполнитьСчетаУчетаВТабличнойЧасти(Док, "Товары");
	КонецЕсли;

	Если Пост Тогда
		Док.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		Док.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ref", СтрокаТипизированнойСсылки(Док.Ссылка));
	Возврат Результат;
КонецФункции

Функция ПрикрепитьФайлКДокументу(Параметры) Экспорт
	Если НЕ Параметры.Свойство("document_ref") Тогда
		ВызватьИсключение "document_ref is required";
	КонецЕсли;
	Если НЕ Параметры.Свойство("content_base64") Тогда
		ВызватьИсключение "content_base64 is required";
	КонецЕсли;

	ДокументСсылка = ПолучитьСсылкуДокументаПоUUID(Параметры.document_ref);
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		ВызватьИсключение "document_ref not found";
	КонецЕсли;

	МодульРаботаСФайлами = ПолучитьМодульРаботыСФайлами();
	Если МодульРаботаСФайлами = Неопределено Тогда
		ВызватьИсключение "attach_file_to_document is not supported: РаботаСФайлами module is unavailable";
	КонецЕсли;
	Если НЕ МодульРаботаСФайлами.КОбъектуМожноПрисоединятьФайлы(ДокументСсылка) Тогда
		ВызватьИсключение "files cannot be attached to this document";
	КонецЕсли;

	ИсходноеИмя = "";
	Если Параметры.Свойство("file_name") Тогда
		ИсходноеИмя = Строка(Параметры.file_name);
	КонецЕсли;
	MIMEТип = "";
	Если Параметры.Свойство("mime_type") Тогда
		MIMEТип = Строка(Параметры.mime_type);
	КонецЕсли;
	ИтоговоеИмя = СформироватьИмяВложения(ДокументСсылка, ИсходноеИмя, MIMEТип);

	СтрокаBase64 = ОчиститьBase64ДляДекодирования(Параметры.content_base64);
	Попытка
		ДвоичныеДанныеФайла = Base64Значение(СтрокаBase64);
	Исключение
		ВызватьИсключение "content_base64 is invalid";
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(ДвоичныеДанныеФайла) Тогда
		ВызватьИсключение "content_base64 is invalid";
	КонецЕсли;

	ПараметрыДобавления = МодульРаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыДобавления.ВладелецФайлов = ДокументСсылка;
	СтруктураИмениФайла = РазобратьИмяФайла(ИтоговоеИмя);
	ПараметрыДобавления.ИмяБезРасширения = СтруктураИмениФайла.ИмяБезРасширения;
	ПараметрыДобавления.РасширениеБезТочки = СтруктураИмениФайла.РасширениеБезТочки;
	Попытка
		ПараметрыДобавления.Комментарий = ?(Параметры.Свойство("comment"), Строка(Параметры.comment), "");
	Исключение
	КонецПопытки;
	Попытка
		ПараметрыДобавления.ТипMIME = MIMEТип;
	Исключение
	КонецПопытки;

	АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
	СсылкаФайла = МодульРаботаСФайлами.ДобавитьФайл(ПараметрыДобавления, АдресФайла);

	Результат = Новый Структура;
	Результат.Вставить("ref", СтрокаСсылкиВложения(СсылкаФайла));
	Результат.Вставить("document_ref", СтрокаТипизированнойСсылки(ДокументСсылка));
	Результат.Вставить("file_name", ИтоговоеИмя);
	Результат.Вставить("mime_type", MIMEТип);
	Результат.Вставить("size_bytes", ДвоичныеДанныеФайла.Размер());
	Возврат Результат;
КонецФункции

Функция ПрочитатьВложенияДокумента(Параметры) Экспорт
	Если НЕ Параметры.Свойство("document_ref") Тогда
		ВызватьИсключение "document_ref is required";
	КонецЕсли;
	ДокументСсылка = ПолучитьСсылкуДокументаПоUUID(Параметры.document_ref);
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		ВызватьИсключение "document_ref not found";
	КонецЕсли;

	Лимит = НормализоватьЛимит(Параметры, 50, 500);
	Поиск = "";
	Если Параметры.Свойство("search") Тогда
		Поиск = НРег(Строка(Параметры.search));
	КонецЕсли;

	СписокВложений = ПолучитьСписокВложенийДокумента(ДокументСсылка);
	Отфильтрованные = Новый Массив;
	Для Каждого Вложение Из СписокВложений Цикл
		Если НЕ ПустаяСтрока(Поиск) Тогда
			Если СтрНайти(НРег(Вложение.file_name), Поиск) = 0 И СтрНайти(НРег(Вложение.description), Поиск) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Отфильтрованные.Добавить(Вложение);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("attachments", Новый Массив);
	Результат.Вставить("total", Отфильтрованные.Количество());
	Результат.Вставить("truncated", Ложь);

	Счетчик = 0;
	Для Каждого Вложение Из Отфильтрованные Цикл
		Если Счетчик >= Лимит Тогда
			Результат.truncated = Истина;
			Прервать;
		КонецЕсли;
		Результат.attachments.Добавить(Вложение);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция ПрочитатьСодержимоеВложенияДокумента(Параметры) Экспорт
	Если НЕ Параметры.Свойство("attachment_ref") Тогда
		ВызватьИсключение "attachment_ref is required";
	КонецЕсли;
	СсылкаФайла = ПолучитьСсылкуПрисоединенногоФайла(Параметры.attachment_ref);

	ДвоичныеДанныеФайла = ПолучитьДвоичныеДанныеВложения(СсылкаФайла);
	МетаданныеВложения = ПреобразоватьВложениеВJSON(СсылкаФайла);
	MIMEТип = "";
	Если МетаданныеВложения.Свойство("mime_type") Тогда
		MIMEТип = Строка(МетаданныеВложения.mime_type);
	КонецЕсли;
	
	Контент = Новый Структура;
	Контент.Вставить("id", МетаданныеВложения.ref);
	Контент.Вставить("name", МетаданныеВложения.file_name);
	Контент.Вставить("mime_type", MIMEТип);
	Контент.Вставить("size_bytes", МетаданныеВложения.size_bytes);
	Контент.Вставить("encoding", "base64");
	Контент.Вставить("content", Base64Строка(ДвоичныеДанныеФайла));
	Контент.Вставить("injection", Новый Структура("mode", ОпределитьРежимИнжектаПоMIME(MIMEТип)));
	Контент.Вставить("contract_version", "1.0");
	
	Результат = Новый Структура;
	Результат.Вставить("content", Контент);
	Возврат Результат;
КонецФункции

Функция ОбновитьМетаданныеВложенияДокумента(Параметры) Экспорт
	Если НЕ Параметры.Свойство("attachment_ref") Тогда
		ВызватьИсключение "attachment_ref is required";
	КонецЕсли;
	Если (НЕ Параметры.Свойство("file_name") И НЕ Параметры.Свойство("description")) Тогда
		ВызватьИсключение "at least one field is required: file_name or description";
	КонецЕсли;

	СсылкаФайла = ПолучитьСсылкуПрисоединенногоФайла(Параметры.attachment_ref);
	ФайлОбъект = СсылкаФайла.ПолучитьОбъект();

	Если Параметры.Свойство("file_name") Тогда
		НовоеИмя = СокрЛП(Строка(Параметры.file_name));
		Если ПустаяСтрока(НовоеИмя) Тогда
			ВызватьИсключение "file_name cannot be empty";
		КонецЕсли;
		Попытка
			ФайлОбъект.Наименование = НовоеИмя;
		Исключение
			ВызватьИсключение "failed to update file_name";
		КонецПопытки;
	КонецЕсли;
	Если Параметры.Свойство("description") Тогда
		НовоеОписание = Строка(Параметры.description);
		Попытка
			ФайлОбъект.Описание = НовоеОписание;
		Исключение
			Попытка
				ФайлОбъект.Комментарий = НовоеОписание;
			Исключение
				ВызватьИсключение "failed to update description";
			КонецПопытки;
		КонецПопытки;
	КонецЕсли;
	ФайлОбъект.Записать();

	Результат = Новый Структура;
	Результат.Вставить("success", Истина);
	Результат.Вставить("attachment", ПреобразоватьВложениеВJSON(СсылкаФайла));
	Возврат Результат;
КонецФункции

Функция ПрочитатьКонтрагентов(Параметры) Экспорт
	Если Параметры.Свойство("ref") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.ref))) Тогда
		З = Новый Запрос;
		З.УстановитьПараметр("СсылкаКонтрагента", Справочники.Контрагенты.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.ref)));
		Возврат ВыполнитьЗапросСписокКонтрагентов(З, Параметры, "Спр.Ссылка = &СсылкаКонтрагента");
	КонецЕсли;
	Если Параметры.Свойство("code") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.code))) Тогда
		З = Новый Запрос;
		З.УстановитьПараметр("КодКонтрагента", СокрЛП(Строка(Параметры.code)));
		Возврат ВыполнитьЗапросСписокКонтрагентов(З, Параметры, "Спр.Код = &КодКонтрагента");
	КонецЕсли;
	Если Параметры.Свойство("inn") И Параметры.Свойство("kpp")
		И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.inn)))
		И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.kpp))) Тогда
		З = Новый Запрос;
		З.УстановитьПараметр("ИННКонтрагента", СокрЛП(Строка(Параметры.inn)));
		З.УстановитьПараметр("КППКонтрагента", СокрЛП(Строка(Параметры.kpp)));
		Возврат ВыполнитьЗапросСписокКонтрагентов(З, Параметры, "Спр.ИНН = &ИННКонтрагента И Спр.КПП = &КППКонтрагента");
	КонецЕсли;

	Возврат ПрочитатьСправочник(
		"Справочник.Контрагенты",
		"counterparties",
		Параметры,
		"Наименование",
		Новый Массив);
КонецФункции

Функция СоздатьКонтрагента(Параметры) Экспорт
	Если НЕ Параметры.Свойство("name") Тогда
		ВызватьИсключение "name is required";
	КонецЕсли;

	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Наименование", Строка(Параметры.name));
	ДанныеЗаполнения.Вставить("НаименованиеПолное", Строка(Параметры.name));
	Если Параметры.Свойство("inn") Тогда ДанныеЗаполнения.Вставить("ИНН", Строка(Параметры.inn)); КонецЕсли;
	Если Параметры.Свойство("kpp") Тогда ДанныеЗаполнения.Вставить("КПП", Строка(Параметры.kpp)); КонецЕсли;
	ДанныеЗаполнения.Вставить("СтранаРегистрации", Справочники.СтраныМира.Россия);
	Если Параметры.Свойство("counterparty_type") Тогда
		Вид = НРег(Строка(Параметры.counterparty_type));
		Если Вид = "legal" ИЛИ Вид = "juridical" Тогда
			ДанныеЗаполнения.Вставить("ЮридическоеФизическоеЛицо", Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
		ИначеЕсли Вид = "individual" ИЛИ Вид = "physical" Тогда
			ДанныеЗаполнения.Вставить("ЮридическоеФизическоеЛицо", Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо);
		КонецЕсли;
	КонецЕсли;

	СсылкаКонтрагента = Справочники.Контрагенты.СоздатьКонтрагента(ДанныеЗаполнения);
	Элемент = СсылкаКонтрагента.ПолучитьОбъект();

	Результат = Новый Структура;
	Результат.Вставить("success", Истина);
	ДанныеКонтрагента = ДанныеСсылкиДляJSON(СсылкаКонтрагента);
	Попытка
		ДанныеКонтрагента.Вставить("inn", Строка(Элемент.ИНН));
	Исключение
	КонецПопытки;
	Попытка
		ДанныеКонтрагента.Вставить("kpp", Строка(Элемент.КПП));
	Исключение
	КонецПопытки;
	Попытка
		ДанныеКонтрагента.Вставить("counterparty_type", Строка(Элемент.ЮридическоеФизическоеЛицо));
	Исключение
	КонецПопытки;
	Результат.Вставить("counterparty", ДанныеКонтрагента);
	Возврат Результат;
КонецФункции

Функция ПрочитатьНоменклатуру(Параметры) Экспорт
	Лимит = НормализоватьЛимит(Параметры, 50, 500);
	ЗапросСписка = Новый Запрос;
	УсловияГДЕ = Новый Массив;

	Если Параметры.Свойство("ref") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.ref))) Тогда
		СсылкаНом = Справочники.Номенклатура.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.ref));
		Если НЕ ЗначениеЗаполнено(СсылкаНом) Тогда
			ВызватьИсключение "ref not found";
		КонецЕсли;
		ПроверитьСуществованиеСсылки(СсылкаНом, "ref");
		ЗапросСписка.УстановитьПараметр("ФильтрСсылкаНом", СсылкаНом);
		УсловияГДЕ.Добавить("Спр.Ссылка = &ФильтрСсылкаНом");
	КонецЕсли;

	Если Параметры.Свойство("code") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.code))) Тогда
		ЗапросСписка.УстановитьПараметр("ФильтрКодНом", СокрЛП(Строка(Параметры.code)));
		УсловияГДЕ.Добавить("Спр.Код = &ФильтрКодНом");
	КонецЕсли;

	Если Параметры.Свойство("article") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.article))) Тогда
		ЗапросСписка.УстановитьПараметр("ФильтрАртикулНом", СокрЛП(Строка(Параметры.article)));
		УсловияГДЕ.Добавить("Спр.Артикул = &ФильтрАртикулНом");
	КонецЕсли;

	ПоискСтрока = "";
	Если Параметры.Свойство("search") Тогда
		ПоискСтрока = СокрЛП(Строка(Параметры.search));
	КонецЕсли;
	Если НЕ ПустаяСтрока(ПоискСтрока) Тогда
		ЗапросСписка.УстановитьПараметр("ПоискНРегНормНом", НормализоватьСтрокуДляПодстрочногоПоиска(ПоискСтрока));
		ВыражКратк = ВыражениеНормализованногоТекстовогоПоляДляЗапроса("Спр.Наименование");
		ВыражПолн = ВыражениеНормализованногоТекстовогоПоляДляЗапроса("Спр.НаименованиеПолное");
		УсловияГДЕ.Добавить("(СтрНайти(" + ВыражКратк + ", &ПоискНРегНормНом) > 0
		|	ИЛИ СтрНайти(" + ВыражПолн + ", &ПоискНРегНормНом) > 0
		|	ИЛИ СтрНайти(НРег(Строка(Спр.Артикул)), &ПоискНРегНормНом) > 0)");
	КонецЕсли;

	Возврат ВыполнитьЗапросСписокНоменклатуры(ЗапросСписка, Параметры, УсловияГДЕ);
КонецФункции

Функция СоздатьНоменклатуру(Параметры) Экспорт
	Если НЕ Параметры.Свойство("name") Тогда
		ВызватьИсключение "name is required";
	КонецЕсли;

	Элемент = Справочники.Номенклатура.СоздатьЭлемент();
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Наименование", Строка(Параметры.name));
	Если Параметры.Свойство("full_name") Тогда ДанныеЗаполнения.Вставить("НаименованиеПолное", Строка(Параметры.full_name)); КонецЕсли;
	Если Параметры.Свойство("article") Тогда ДанныеЗаполнения.Вставить("Артикул", Строка(Параметры.article)); КонецЕсли;
	Если Параметры.Свойство("is_service") Тогда ДанныеЗаполнения.Вставить("Услуга", Булево(Параметры.is_service)); КонецЕсли;
	Элемент.Заполнить(ДанныеЗаполнения);
	Элемент.Записать();

	Результат = Новый Структура;
	Результат.Вставить("success", Истина);
	ДанныеНоменклатуры = ДанныеСсылкиДляJSON(Элемент.Ссылка);
	Попытка
		ДанныеНоменклатуры.Вставить("full_name", Строка(Элемент.НаименованиеПолное));
	Исключение
	КонецПопытки;
	Попытка
		ДанныеНоменклатуры.Вставить("article", Строка(Элемент.Артикул));
	Исключение
	КонецПопытки;
	Попытка
		ДанныеНоменклатуры.Вставить("is_service", Элемент.Услуга);
	Исключение
	КонецПопытки;
	Результат.Вставить("nomenclature", ДанныеНоменклатуры);
	Возврат Результат;
КонецФункции

Функция ПрочитатьОрганизации(Параметры) Экспорт
	Если Параметры.Свойство("ref") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.ref))) Тогда
		З = Новый Запрос;
		З.УстановитьПараметр("СсылкаОрганизации", Справочники.Организации.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.ref)));
		Возврат ВыполнитьЗапросСписокОрганизаций(З, Параметры, "Спр.Ссылка = &СсылкаОрганизации");
	КонецЕсли;
	Если Параметры.Свойство("code") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.code))) Тогда
		З = Новый Запрос;
		З.УстановитьПараметр("КодОрганизации", СокрЛП(Строка(Параметры.code)));
		Возврат ВыполнитьЗапросСписокОрганизаций(З, Параметры, "Спр.Код = &КодОрганизации");
	КонецЕсли;
	Если Параметры.Свойство("inn") И Параметры.Свойство("kpp")
		И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.inn)))
		И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.kpp))) Тогда
		З = Новый Запрос;
		З.УстановитьПараметр("ИННОрганизации", СокрЛП(Строка(Параметры.inn)));
		З.УстановитьПараметр("КППОрганизации", СокрЛП(Строка(Параметры.kpp)));
		Возврат ВыполнитьЗапросСписокОрганизаций(З, Параметры, "Спр.ИНН = &ИННОрганизации И Спр.КПП = &КППОрганизации");
	КонецЕсли;

	Возврат ПрочитатьСправочник(
		"Справочник.Организации",
		"organizations",
		Параметры,
		"Наименование",
		Новый Массив);
КонецФункции

Функция ПрочитатьДоговоры(Параметры) Экспорт
	Лимит = НормализоватьЛимит(Параметры, 50, 500);
	ЗапросСписка = Новый Запрос;
	УсловияГДЕ = Новый Массив;

	Если Параметры.Свойство("ref") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.ref))) Тогда
		ДоговорСсылка = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.ref));
		Если НЕ ЗначениеЗаполнено(ДоговорСсылка) Тогда
			ВызватьИсключение "ref not found";
		КонецЕсли;
		ПроверитьСуществованиеСсылки(ДоговорСсылка, "ref");
		ЗапросСписка.УстановитьПараметр("ФильтрСсылкаДог", ДоговорСсылка);
		УсловияГДЕ.Добавить("Спр.Ссылка = &ФильтрСсылкаДог");
	КонецЕсли;

	Если Параметры.Свойство("code") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.code))) Тогда
		ЗапросСписка.УстановитьПараметр("ФильтрКодДог", СокрЛП(Строка(Параметры.code)));
		УсловияГДЕ.Добавить("Спр.Код = &ФильтрКодДог");
	КонецЕсли;

	Если Параметры.Свойство("number") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.number))) Тогда
		ЗапросСписка.УстановитьПараметр("ФильтрНомерДог", СокрЛП(Строка(Параметры.number)));
		УсловияГДЕ.Добавить("Спр.Номер = &ФильтрНомерДог");
	КонецЕсли;

	Если Параметры.Свойство("counterparty_ref") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.counterparty_ref))) Тогда
		Контрагент = Справочники.Контрагенты.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.counterparty_ref));
		Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
			ВызватьИсключение "counterparty_ref not found";
		КонецЕсли;
		ПроверитьСуществованиеСсылки(Контрагент, "counterparty_ref");
		ЗапросСписка.УстановитьПараметр("ФильтрКонтрДог", Контрагент);
		УсловияГДЕ.Добавить("Спр.Владелец = &ФильтрКонтрДог");
	КонецЕсли;

	Если Параметры.Свойство("organization_ref") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.organization_ref))) Тогда
		Организация = Справочники.Организации.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.organization_ref));
		Если НЕ ЗначениеЗаполнено(Организация) Тогда
			ВызватьИсключение "organization_ref not found";
		КонецЕсли;
		ПроверитьСуществованиеСсылки(Организация, "organization_ref");
		ЗапросСписка.УстановитьПараметр("ФильтрОргДог", Организация);
		УсловияГДЕ.Добавить("Спр.Организация = &ФильтрОргДог");
	КонецЕсли;

	ПоискСтрока = "";
	Если Параметры.Свойство("search") Тогда
		ПоискСтрока = СокрЛП(Строка(Параметры.search));
	КонецЕсли;
	// У справочника ДоговорыКонтрагентов (БП) нет реквизита НаименованиеПолное — только стандартное Наименование и Номер.
	Если НЕ ПустаяСтрока(ПоискСтрока) Тогда
		ЗапросСписка.УстановитьПараметр("ПоискНРегНормДог", НормализоватьСтрокуДляПодстрочногоПоиска(ПоискСтрока));
		ВыражКратк = ВыражениеНормализованногоТекстовогоПоляДляЗапроса("Спр.Наименование");
		УсловияГДЕ.Добавить("(СтрНайти(" + ВыражКратк + ", &ПоискНРегНормДог) > 0
		|	ИЛИ СтрНайти(НРег(Строка(Спр.Номер)), &ПоискНРегНормДог) > 0)");
	КонецЕсли;

	Возврат ВыполнитьЗапросСписокДоговоров(ЗапросСписка, Параметры, УсловияГДЕ);
КонецФункции

Функция ПрочитатьДокументыПродаж(Параметры, ИмяТаблицыДокумента, ИмяМассиваВОтвете) Экспорт
	Лимит = НормализоватьЛимит(Параметры, 50, 500);
	ИмяДокументаБезПрефикса = Сред(ИмяТаблицыДокумента, 10);

	ЗапросСписка = Неопределено;
	УсловияГДЕ = Новый Массив;

	Если Параметры.Свойство("ref") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.ref))) Тогда
		СтрРеф = СокрЛП(Строка(Параметры.ref));
		СсылкаДок = ПолучитьСсылкуДокументаПоUUID(СтрРеф);
		Если НЕ ЗначениеЗаполнено(СсылкаДок) Тогда
			СсылкаДок = Документы[ИмяДокументаБезПрефикса].ПолучитьСсылку(UUIDИзСтроки(СтрРеф));
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СсылкаДок) Тогда
			ВызватьИсключение "ref not found";
		КонецЕсли;
		ЗапросСписка = Новый Запрос;
		ЗапросСписка.УстановитьПараметр("ФильтрСсылкаДок", СсылкаДок);
		УсловияГДЕ.Добавить("Док.Ссылка = &ФильтрСсылкаДок");
	КонецЕсли;

	Если Параметры.Свойство("number") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.number))) Тогда
		Если ЗапросСписка = Неопределено Тогда
			ЗапросСписка = Новый Запрос;
		КонецЕсли;
		ЗапросСписка.УстановитьПараметр("ФильтрНомерДок", СокрЛП(Строка(Параметры.number)));
		УсловияГДЕ.Добавить("Док.Номер = &ФильтрНомерДок");
	КонецЕсли;

	Если Параметры.Свойство("counterparty_ref") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.counterparty_ref))) Тогда
		Если ЗапросСписка = Неопределено Тогда
			ЗапросСписка = Новый Запрос;
		КонецЕсли;
		Контрагент = Справочники.Контрагенты.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.counterparty_ref));
		Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
			ВызватьИсключение "counterparty_ref not found";
		КонецЕсли;
		ПроверитьСуществованиеСсылки(Контрагент, "counterparty_ref");
		ЗапросСписка.УстановитьПараметр("ФильтрКонтрагент", Контрагент);
		УсловияГДЕ.Добавить("Док.Контрагент = &ФильтрКонтрагент");
	КонецЕсли;

	Если Параметры.Свойство("organization_ref") И ЗначениеЗаполнено(СокрЛП(Строка(Параметры.organization_ref))) Тогда
		Если ЗапросСписка = Неопределено Тогда
			ЗапросСписка = Новый Запрос;
		КонецЕсли;
		Организация = Справочники.Организации.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.organization_ref));
		Если НЕ ЗначениеЗаполнено(Организация) Тогда
			ВызватьИсключение "organization_ref not found";
		КонецЕсли;
		ПроверитьСуществованиеСсылки(Организация, "organization_ref");
		ЗапросСписка.УстановитьПараметр("ФильтрОрганизация", Организация);
		УсловияГДЕ.Добавить("Док.Организация = &ФильтрОрганизация");
	КонецЕсли;

	ПоискСтрока = "";
	Если Параметры.Свойство("search") Тогда
		ПоискСтрока = СокрЛП(Строка(Параметры.search));
	КонецЕсли;
	ИспользоватьПоиск = НЕ ПустаяСтрока(ПоискСтрока);
	Если ИспользоватьПоиск Тогда
		Если ЗапросСписка = Неопределено Тогда
			ЗапросСписка = Новый Запрос;
		КонецЕсли;
		ЗапросСписка.УстановитьПараметр("ПоискНРегДок", НРег(ПоискСтрока));
		УсловияГДЕ.Добавить("(СтрНайти(НРег(Строка(Док.Номер)), &ПоискНРегДок) > 0
		|	ИЛИ СтрНайти(НРег(Строка(Док.Комментарий)), &ПоискНРегДок) > 0)");
	КонецЕсли;

	Если ЗапросСписка = Неопределено Тогда
		ЗапросСписка = Новый Запрос;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
	|	Док.Ссылка КАК Ref,
	|	Док.Номер КАК Number,
	|	Док.Дата КАК Date,
	|	Док.Организация КАК Organization,
	|	Док.Контрагент КАК Counterparty,
	|	Док.ДоговорКонтрагента КАК Contract,
	|	Док.СуммаДокумента КАК Amount,
	|	Док.Проведен КАК Posted
	|ИЗ
	|	" + ИмяТаблицыДокумента + " КАК Док";

	Если УсловияГДЕ.Количество() > 0 Тогда
		ТекстУсловий = "";
