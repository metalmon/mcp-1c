// Нормализует строку для подстрочного поиска по наименованию: НРег, снятие типографских кавычек
// и неразрывного пробела (чтобы «ООО Технологии связи» находило ООО «ТЕХНОЛОГИИ СВЯЗИ»).
Функция НормализоватьСтрокуДляПодстрочногоПоиска(Знач Текст)
	Р = НРег(СокрЛП(Строка(Текст)));
	Р = СтрЗаменить(Р, "«", "");
	Р = СтрЗаменить(Р, "»", "");
	Р = СтрЗаменить(Р, """", "");
	Р = СтрЗаменить(Р, "'", "");
	Р = СтрЗаменить(Р, Символ(160), " ");
	Пока СтрНайти(Р, "  ") > 0 Цикл
		Р = СтрЗаменить(Р, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Р);
КонецФункции

// Нормализация текста поля в запросе (снятие «»; остальное — в НормализоватьСтрокуДляПодстрочногоПоиска для строки поиска).
// ПутьПоля — например "Спр.Наименование" или "Спр.НаименованиеПолное".
Функция ВыражениеНормализованногоТекстовогоПоляДляЗапроса(ПутьПоля)
	Возврат
	"СтрЗаменить(СтрЗаменить(НРег(Строка(" + ПутьПоля + ")), ""«"", """"), ""»"", """")";
КонецФункции

// Выражение языка запросов для краткого наименования (как в списке справочника).
Функция ВыражениеНормализованногоНаименованияДляЗапроса()
	Возврат ВыражениеНормализованногоТекстовогоПоляДляЗапроса("Спр.Наименование");
КонецФункции

Функция ПрочитатьСправочник(ИмяТаблицы, ИмяМассива, Параметры, ИмяПоляСортировки, ДопПоля)
	Лимит = НормализоватьЛимит(Параметры, 50, 500);
	ПоискСтрока = "";
	Если Параметры.Свойство("search") Тогда
		ПоискСтрока = СокрЛП(Строка(Параметры.search));
	КонецЕсли;
	ИспользоватьПоиск = НЕ ПустаяСтрока(ПоискСтрока);

	ДобавитьИННКППВВыборку = (ИмяТаблицы = "Справочник.Контрагенты"
		Или ИмяТаблицы = "Справочник.Организации");
	ДобавитьВидКонтрагента = (ИмяТаблицы = "Справочник.Контрагенты");

	ЗапросСписка = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
	|	Спр.Ссылка КАК Ref,
	|	Спр.Код КАК Code,
	|	Спр.Наименование КАК Name";

	Если ДобавитьИННКППВВыборку Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	,
		|	Спр.ИНН КАК INN,
		|	Спр.КПП КАК KPP";
	КонецЕсли;
	Если ДобавитьВидКонтрагента Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	,
		|	Спр.ЮридическоеФизическоеЛицо КАК CounterpartyType";
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + "
	|ИЗ
	|	" + ИмяТаблицы + " КАК Спр";

	Если ИспользоватьПоиск Тогда
		ЗапросСписка.УстановитьПараметр("ПоискНРегНорм", НормализоватьСтрокуДляПодстрочногоПоиска(ПоискСтрока));
		ВыражКратк = ВыражениеНормализованногоТекстовогоПоляДляЗапроса("Спр.Наименование");
		// НаименованиеПолное есть не у всех справочников (напр. у ДоговорыКонтрагентов в БП нет).
		ПоискПоПолномуНаименованию = (ИмяТаблицы = "Справочник.Контрагенты"
			Или ИмяТаблицы = "Справочник.Организации");
		Если ПоискПоПолномуНаименованию Тогда
			ВыражПолн = ВыражениеНормализованногоТекстовогоПоляДляЗапроса("Спр.НаименованиеПолное");
			УсловиеПоиска =
			"(СтрНайти(" + ВыражКратк + ", &ПоискНРегНорм) > 0
			|	ИЛИ СтрНайти(" + ВыражПолн + ", &ПоискНРегНорм) > 0)";
		Иначе
			УсловиеПоиска = "СтрНайти(" + ВыражКратк + ", &ПоискНРегНорм) > 0";
		КонецЕсли;
		Если ИмяТаблицы = "Справочник.Контрагенты"
			Или ИмяТаблицы = "Справочник.Организации" Тогда
			УсловиеПоиска = УсловиеПоиска + "
			|	ИЛИ СтрНайти(НРег(Строка(Спр.ИНН)), &ПоискНРегНорм) > 0";
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + "
		|ГДЕ
		|	(" + УсловиеПоиска + ")";
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + "
	|УПОРЯДОЧИТЬ ПО
	|	Спр." + ИмяПоляСортировки;

	ЗапросСписка.Текст = ТекстЗапроса;
	Выборка = ЗапросСписка.Выполнить().Выбрать();

	Коллекция = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("ref", СтрокаТипизированнойСсылки(Выборка.Ref));
		Стр.Вставить("code", Строка(Выборка.Code));
		Стр.Вставить("name", Строка(Выборка.Name));
		Если ДобавитьИННКППВВыборку Тогда
			Стр.Вставить("inn", Строка(Выборка.INN));
			Стр.Вставить("kpp", Строка(Выборка.KPP));
		КонецЕсли;
		Если ДобавитьВидКонтрагента Тогда
			Стр.Вставить("counterparty_type", Строка(Выборка.CounterpartyType));
		КонецЕсли;
		Коллекция.Добавить(Стр);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить(ИмяМассива, Коллекция);
	Результат.Вставить("total", Коллекция.Количество());
	Результат.Вставить("truncated", ИспользоватьПоиск И (Коллекция.Количество() = Лимит));
	Возврат Результат;
КонецФункции

Функция НормализоватьЛимит(Параметры, ЗначениеПоУмолчанию, Максимум)
	Лимит = ЗначениеПоУмолчанию;
	Если Параметры.Свойство("limit") Тогда
		Попытка
			Лимит = Число(Параметры.limit);
		Исключение
			Лимит = ЗначениеПоУмолчанию;
		КонецПопытки;
	КонецЕсли;
	Если Лимит <= 0 Тогда
		Лимит = ЗначениеПоУмолчанию;
	ИначеЕсли Лимит > Максимум Тогда
		Лимит = Максимум;
	КонецЕсли;
	Возврат Лимит;
КонецФункции

Функция UUIDИзСтроки(ЗначениеUUID)
	Попытка
		Возврат Новый УникальныйИдентификатор(Строка(ЗначениеUUID));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция UUIDИзRefСтроки(ЗначениеRef)
	Если НЕ ЗначениеЗаполнено(ЗначениеRef) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаRef = СокрЛП(Строка(ЗначениеRef));
	ПозицияРазделителя = СтрНайти(СтрокаRef, ":");
	Если ПозицияРазделителя <= 1 Тогда
		// Плоский UUID без префикса «Тип:» (как в JSON-схемах MCP).
		Возврат UUIDИзСтроки(СтрокаRef);
	КонецЕсли;
	UUIDЧасть = Сред(СтрокаRef, ПозицияРазделителя + 1);
	
	Возврат UUIDИзСтроки(UUIDЧасть);
КонецФункции

Функция ДатаИзСтроки(ЗначениеДаты)
	Попытка
		Возврат XMLЗначение(Тип("Дата"), ЗначениеДаты);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция СсылкаВUUIDСтроку(Ссылка)
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Строка(Ссылка.УникальныйИдентификатор());
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция СтрокаТипизированнойСсылки(Ссылка)
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Ссылка.Метаданные().ПолноеИмя() + ":" + СсылкаВUUIDСтроку(Ссылка);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Процедура ПроверитьСуществованиеСсылки(Ссылка, ИмяПоля)
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение ИмяПоля + " is empty";
	КонецЕсли;
	Попытка
		ОбъектСсылки = Ссылка.ПолучитьОбъект();
		Если ОбъектСсылки = Неопределено Тогда
			ВызватьИсключение ИмяПоля + " not found";
		КонецЕсли;
		Попытка
			Если ОбъектСсылки.ПометкаУдаления Тогда
				ВызватьИсключение ИмяПоля + " points to deleted object";
			КонецЕсли;
		Исключение
		КонецПопытки;
	Исключение
		ВызватьИсключение ИмяПоля + " not found";
	КонецПопытки;
КонецПроцедуры

Функция ДанныеСсылкиДляJSON(Ссылка)
	Объект = Ссылка.ПолучитьОбъект();
	Данные = Новый Структура;
	Данные.Вставить("ref", СтрокаТипизированнойСсылки(Ссылка));
	Код = "";
	Наименование = "";
	Попытка
		Код = Объект.Код;
	Исключение
	КонецПопытки;
	Попытка
		Наименование = Объект.Наименование;
	Исключение
	КонецПопытки;
	Данные.Вставить("code", Код);
	Данные.Вставить("name", Наименование);
	Возврат Данные;
КонецФункции

Функция ПолучитьСсылкуДокументаПродаж(ТипДокумента, RefСтрока)
	Если ТипДокумента = "СчетНаОплатуПокупателю" Тогда
		Возврат Документы.СчетНаОплатуПокупателю.ПолучитьСсылку(UUIDИзRefСтроки(RefСтрока));
	КонецЕсли;
	Возврат Документы.РеализацияТоваровУслуг.ПолучитьСсылку(UUIDИзRefСтроки(RefСтрока));
КонецФункции

Функция ПолучитьСсылкуДокументаПоUUID(RefСтрока)
	ОписаниеСсылки = РазобратьТипизированнуюСсылку(RefСтрока);
	Если ОписаниеСсылки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Лев(ОписаниеСсылки.ИмяТипа, 9) <> "Документ." Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяДокумента = Сред(ОписаниеСсылки.ИмяТипа, 10);
	Если ПустаяСтрока(ИмяДокумента) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		СсылкаДок = Документы[ИмяДокумента].ПолучитьСсылку(ОписаниеСсылки.UUID);
		Если ЗначениеЗаполнено(СсылкаДок) Тогда
			СсылкаДок.ПолучитьОбъект();
			Возврат СсылкаДок;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьМодульРаботыСФайлами()
	Попытка
		Возврат ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Удаляет пробелы/переносы из base64: иначе Base64Значение даёт «битый» PDF и файл в 1С не открывается.
Функция ОчиститьBase64ДляДекодирования(Знач ИсходнаяСтрока)
	С = Строка(ИсходнаяСтрока);
	С = СтрЗаменить(С, " ", "");
	С = СтрЗаменить(С, Символы.ПС, "");
	С = СтрЗаменить(С, Символы.ВК, "");
	С = СтрЗаменить(С, Символ(9), "");
	С = СтрЗаменить(С, Символ(160), "");
	Возврат С;
КонецФункции

Функция РасширениеФайлаПоMIME(Знач MIMEСтрока)
	M = НРег(СокрЛП(Строка(MIMEСтрока)));
	Если ПустаяСтрока(M) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрНайти(M, "application/pdf") > 0 Тогда
		Возврат "pdf";
	ИначеЕсли СтрНайти(M, "image/png") > 0 Тогда
		Возврат "png";
	ИначеЕсли СтрНайти(M, "image/jpeg") > 0 Или СтрНайти(M, "image/jpg") > 0 Тогда
		Возврат "jpg";
	ИначеЕсли СтрНайти(M, "image/gif") > 0 Тогда
		Возврат "gif";
	ИначеЕсли СтрНайти(M, "image/webp") > 0 Тогда
		Возврат "webp";
	ИначеЕсли СтрНайти(M, "application/vnd.openxmlformats-officedocument.wordprocessingml.document") > 0 Тогда
		Возврат "docx";
	ИначеЕсли СтрНайти(M, "application/msword") > 0 Тогда
		Возврат "doc";
	ИначеЕсли СтрНайти(M, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet") > 0 Тогда
		Возврат "xlsx";
	ИначеЕсли СтрНайти(M, "text/plain") > 0 Тогда
		Возврат "txt";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция СформироватьИмяВложения(ДокументСсылка, ИсходноеИмя, MIMEТип = "")
	Расширение = "pdf";
	БазовоеИмя = "";
	РасширениеИзИмени = "";
	Если ЗначениеЗаполнено(ИсходноеИмя) Тогда
		СтруктураИмениФайла = РазобратьИмяФайла(ИсходноеИмя);
		Если ЗначениеЗаполнено(СтруктураИмениФайла.ИмяБезРасширения) Тогда
			БазовоеИмя = СтруктураИмениФайла.ИмяБезРасширения;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураИмениФайла.РасширениеБезТочки) Тогда
			РасширениеИзИмени = НРег(СтруктураИмениФайла.РасширениеБезТочки);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(РасширениеИзИмени) Тогда
		Расширение = РасширениеИзИмени;
	Иначе
		ПоMIME = РасширениеФайлаПоMIME(MIMEТип);
		Если НЕ ПустаяСтрока(ПоMIME) Тогда
			Расширение = ПоMIME;
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(БазовоеИмя) Тогда
		БазовоеИмя = "attachment";
	КонецЕсли;

	Попытка
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		ТипДок = ДокументСсылка.Метаданные().Имя;
		НомерДок = Строка(ДокОбъект.Номер);
		ДатаДок = Формат(ДокОбъект.Дата, "ДФ=yyyyMMdd");
	Исключение
		ТипДок = "Документ";
		НомерДок = "";
		ДатаДок = Формат(ТекущаяДата(), "ДФ=yyyyMMdd");
	КонецПопытки;

	Возврат ТипДок + "_" + НомерДок + "_" + ДатаДок + "_" + БазовоеИмя + "." + Расширение;
КонецФункции

Функция РазобратьИмяФайла(ПолноеИмяФайла)
	ИмяФайла = СокрЛП(Строка(ПолноеИмяФайла));
	ПозицияТочки = 0;
	Индекс = СтрДлина(ИмяФайла);
	Пока Индекс >= 1 Цикл
		Если Сред(ИмяФайла, Индекс, 1) = "." Тогда
			ПозицияТочки = Индекс;
			Прервать;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	ИмяБезРасширения = ИмяФайла;
	РасширениеБезТочки = "";
	Если ПозицияТочки > 1 Тогда
		ИмяБезРасширения = Лев(ИмяФайла, ПозицияТочки - 1);
		РасширениеБезТочки = НРег(Сред(ИмяФайла, ПозицияТочки + 1));
	КонецЕсли;
	
	Возврат Новый Структура("ИмяБезРасширения,РасширениеБезТочки", ИмяБезРасширения, РасширениеБезТочки);
КонецФункции

Функция ПолучитьСписокВложенийДокумента(ДокументСсылка)
	МодульРаботаСФайлами = ПолучитьМодульРаботыСФайлами();
	Если МодульРаботаСФайлами = Неопределено Тогда
		ВызватьИсключение "document attachments are not supported: РаботаСФайлами module is unavailable";
	КонецЕсли;
	Если НЕ МодульРаботаСФайлами.КОбъектуМожноПрисоединятьФайлы(ДокументСсылка) Тогда
		ВызватьИсключение "files cannot be attached to this document";
	КонецЕсли;

	МассивФайлов = Новый Массив;
	Попытка
		МодульРаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ДокументСсылка, МассивФайлов);
	Исключение
		ВызватьИсключение "document attachments listing failed in РаботаСФайлами";
	КонецПопытки;

	Результат = Новый Массив;
	Для Каждого СсылкаФайла Из МассивФайлов Цикл
		Если ЗначениеЗаполнено(СсылкаФайла) Тогда
			Результат.Добавить(ПреобразоватьВложениеВJSON(СсылкаФайла));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьСсылкуПрисоединенногоФайла(RefСтрока)
	СтрокаСсылки = СокрЛП(Строка(RefСтрока));
	Если СтрНайти(НРег(СтрокаСсылки), "attachmentcatalog:") = 1 Тогда
		ВызватьИсключение "attachment_ref: attachmentCatalog:<uuid> is removed; use Справочник.<ИмяКаталогаПрисоединенныхФайлов>:<uuid>";
	КонецЕсли;

	ОписаниеСсылки = РазобратьСтрокуСсылкиВложения(RefСтрока);
	Если ОписаниеСсылки = Неопределено Тогда
		ВызватьИсключение "attachment_ref is invalid";
	КонецЕсли;

	Попытка
		Ссылка = Справочники[ОписаниеСсылки.ИмяСправочника].ПолучитьСсылку(ОписаниеСсылки.UUID);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Ссылка.ПолучитьОбъект();
			Возврат Ссылка;
		КонецЕсли;
	Исключение
		ВызватьИсключение "attachment_ref not found";
	КонецПопытки;

	ВызватьИсключение "attachment_ref not found";
КонецФункции

Функция ПолучитьДвоичныеДанныеВложения(СсылкаФайла)
	МодульРаботаСФайлами = ПолучитьМодульРаботыСФайлами();
	Если МодульРаботаСФайлами = Неопределено Тогда
		ВызватьИсключение "attachment content read is not supported: РаботаСФайлами module is unavailable";
	КонецЕсли;
	
	ОшибкаЧтенияЧерезДвоичныеДанные = "";
	Попытка
		ДвоичныеДанные = МодульРаботаСФайлами.ДвоичныеДанныеФайла(СсылкаФайла);
		Если ЗначениеЗаполнено(ДвоичныеДанные) Тогда
			Возврат ДвоичныеДанные;
		КонецЕсли;
	Исключение
		ОшибкаЧтенияЧерезДвоичныеДанные = ОписаниеОшибки();
	КонецПопытки;
	
	ОшибкаЧтенияЧерезДанныеФайла = "";
	Попытка
		ПараметрыДанныхФайла = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
		ПараметрыДанныхФайла.ПолучатьСсылкуНаДвоичныеДанные = Истина;
		ПараметрыДанныхФайла.ИдентификаторФормы = Новый УникальныйИдентификатор;
		ДанныеФайла = МодульРаботаСФайлами.ДанныеФайла(СсылкаФайла, ПараметрыДанныхФайла);
		Если ДанныеФайла <> Неопределено
			И ДанныеФайла.Свойство("СсылкаНаДвоичныеДанныеФайла")
			И ЗначениеЗаполнено(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла) Тогда
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
			Если ЗначениеЗаполнено(ДвоичныеДанные) Тогда
				Возврат ДвоичныеДанные;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ОшибкаЧтенияЧерезДанныеФайла = ОписаниеОшибки();
	КонецПопытки;
	
	ТекстОшибки = "attachment content read failed";
	Если НЕ ПустаяСтрока(ОшибкаЧтенияЧерезДвоичныеДанные) Тогда
		ТекстОшибки = ТекстОшибки + "; ДвоичныеДанныеФайла: " + ОшибкаЧтенияЧерезДвоичныеДанные;
	КонецЕсли;
	Если НЕ ПустаяСтрока(ОшибкаЧтенияЧерезДанныеФайла) Тогда
		ТекстОшибки = ТекстОшибки + "; ДанныеФайла: " + ОшибкаЧтенияЧерезДанныеФайла;
	КонецЕсли;
	ВызватьИсключение ТекстОшибки;
КонецФункции

Функция ПреобразоватьВложениеВJSON(СсылкаФайла)
	ФайлОбъект = СсылкаФайла.ПолучитьОбъект();
	Данные = Новый Структура;
	Данные.Вставить("ref", СтрокаСсылкиВложения(СсылкаФайла));
	Данные.Вставить("document_ref", "");
	Данные.Вставить("file_name", "");
	Данные.Вставить("description", "");
	Данные.Вставить("mime_type", "");
	Данные.Вставить("size_bytes", 0);
	Данные.Вставить("created_at", "");

	Попытка
		Данные.document_ref = СтрокаТипизированнойСсылки(ФайлОбъект.ВладелецФайла);
	Исключение
	КонецПопытки;
	Попытка
		Данные.file_name = Строка(ФайлОбъект.Наименование);
	Исключение
	КонецПопытки;
	Попытка
		РасширениеФайла = Строка(ФайлОбъект.Расширение);
		Если ЗначениеЗаполнено(РасширениеФайла) Тогда
			Если Лев(РасширениеФайла, 1) = "." Тогда
				РасширениеФайла = Сред(РасширениеФайла, 2);
			КонецЕсли;
			Если НЕ ПустаяСтрока(РасширениеФайла) Тогда
				Если СтрНайти(Данные.file_name, ".") = 0 Тогда
					Данные.file_name = Данные.file_name + "." + РасширениеФайла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Данные.description = Строка(ФайлОбъект.Описание);
	Исключение
		Попытка
			Данные.description = Строка(ФайлОбъект.Комментарий);
		Исключение
		КонецПопытки;
	КонецПопытки;
	Попытка
		Данные.mime_type = Строка(ФайлОбъект.ТипMIME);
	Исключение
	КонецПопытки;
	Попытка
		Данные.size_bytes = Число(ФайлОбъект.Размер);
	Исключение
	КонецПопытки;
	Попытка
		Данные.created_at = Строка(ФайлОбъект.ДатаСоздания);
	Исключение
	КонецПопытки;
	Возврат Данные;
КонецФункции

Функция СтрокаСсылкиВложения(СсылкаФайла)
	Возврат СтрокаТипизированнойСсылки(СсылкаФайла);
КонецФункции

Функция РазобратьСтрокуСсылкиВложения(RefСтрока)
	СтрокаСсылки = СокрЛП(Строка(RefСтрока));
	ПозицияРазделителя = СтрНайти(СтрокаСсылки, ":");
	Если ПозицияРазделителя <= 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЛеваяЧасть = Лев(СтрокаСсылки, ПозицияРазделителя - 1);
	Если НРег(ЛеваяЧасть) = "attachmentcatalog" Тогда
		Возврат Неопределено;
	КонецЕсли;

	UUIDСтрокой = Сред(СтрокаСсылки, ПозицияРазделителя + 1);
	UUIDФайла = UUIDИзСтроки(UUIDСтрокой);
	Если UUIDФайла = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяСправочника = ЛеваяЧасть;
	ДлинаПрефикса = СтрДлина("Справочник.");
	Если СтрДлина(ЛеваяЧасть) > ДлинаПрефикса
		И НРег(Лев(ЛеваяЧасть, ДлинаПрефикса)) = НРег("Справочник.") Тогда
		ИмяСправочника = Сред(ЛеваяЧасть, ДлинаПрефикса + 1);
	КонецЕсли;

	Возврат Новый Структура("ИмяСправочника,UUID", ИмяСправочника, UUIDФайла);
КонецФункции

Функция РазобратьТипизированнуюСсылку(RefСтрока)
	Если НЕ ЗначениеЗаполнено(RefСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаСсылки = СокрЛП(Строка(RefСтрока));
	ПозицияРазделителя = СтрНайти(СтрокаСсылки, ":");
	Если ПозицияРазделителя <= 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяТипа = Лев(СтрокаСсылки, ПозицияРазделителя - 1);
	UUIDСтрокой = Сред(СтрокаСсылки, ПозицияРазделителя + 1);
	UUIDСсылки = UUIDИзСтроки(UUIDСтрокой);
	Если UUIDСсылки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Структура("ИмяТипа,UUID", ИмяТипа, UUIDСсылки);
КонецФункции

Функция ОпределитьРежимИнжектаПоMIME(MIMEТип)
	НормализованныйТип = НРег(СокрЛП(Строка(MIMEТип)));
	Если Лев(НормализованныйТип, 6) = "image/" Тогда
		Возврат "multimodal_image";
	КонецЕсли;
	Если Лев(НормализованныйТип, 5) = "text/"
		ИЛИ НормализованныйТип = "application/json"
		ИЛИ НормализованныйТип = "application/xml"
		ИЛИ НормализованныйТип = "text/xml"
		ИЛИ НормализованныйТип = "application/csv" Тогда
		Возврат "inline_text";
	КонецЕсли;
	Возврат "file_reference";
КонецФункции

Процедура ЗаполнитьТоварыДокументаПродаж(Док, Параметры, Пост, ЗаменитьСуществующие)
	Если Пост И (НЕ Параметры.Свойство("items") ИЛИ ТипЗнч(Параметры.items) <> Тип("Массив") ИЛИ Параметры.items.Количество() = 0) Тогда
		Если НЕ ЗаменитьСуществующие ИЛИ Док.Товары.Количество() = 0 Тогда
			ВызватьИсключение "items are required when post=true";
		КонецЕсли;
	КонецЕсли;

	Если Параметры.Свойство("items") И ТипЗнч(Параметры.items) = Тип("Массив") Тогда
		Если ЗаменитьСуществующие Тогда
			Док.Товары.Очистить();
		КонецЕсли;
		НомерСтроки = 0;
		Для Каждого СтрТов Из Параметры.items Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НЕ СтрТов.Свойство("nomenclature_ref") Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].nomenclature_ref is required";
			КонецЕсли;
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(UUIDИзRefСтроки(СтрТов.nomenclature_ref));
			Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].nomenclature_ref not found";
			КонецЕсли;
			ПроверитьСуществованиеСсылки(Номенклатура, "items[" + Строка(НомерСтроки) + "].nomenclature_ref");
			СтрокаТЧ = Док.Товары.Добавить();
			СтрокаТЧ.Номенклатура = Номенклатура;
			Если Пост И НЕ СтрТов.Свойство("quantity") Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].quantity is required when post=true";
			КонецЕсли;
			Если Пост И НЕ СтрТов.Свойство("price") Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].price is required when post=true";
			КонецЕсли;
			Если СтрТов.Свойство("quantity") Тогда СтрокаТЧ.Количество = Число(СтрТов.quantity); Иначе СтрокаТЧ.Количество = 1; КонецЕсли;
			Если СтрТов.Свойство("price") Тогда СтрокаТЧ.Цена = Число(СтрТов.price); КонецЕсли;
			Если Пост И СтрокаТЧ.Количество <= 0 Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].quantity must be > 0 when post=true";
			КонецЕсли;
			Если Пост И СтрокаТЧ.Цена <= 0 Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].price must be > 0 when post=true";
			КонецЕсли;
			Попытка
				ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТЧ, Док, "Товары", Док.Метаданные());
			Исключение
			КонецПопытки;
			Если НЕ СтрТов.Свойство("quantity") Тогда
				СтрокаТЧ.Количество = 1;
			КонецЕсли;
			ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуТабЧасти(СтрокаТЧ);
			ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтрокаТЧ, Док.СуммаВключаетНДС);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#Область ПоступлениеТоваровУслуг

// Создать «Поступление товаров и услуг» по данным, разрешённым OCR-клиентом.
// Все справочники (Организация, Контрагент, Договор, Номенклатура) уже
// сопоставлены — на вход приходят типизированные ref'ы. Это сознательно
// делает BSL-сторону тонкой: матчинг и YOLO-создание справочников
// выполняются на стороне клиента через существующие read_* / create_* tools.
Функция СоздатьПоступление(Параметры) Экспорт
	Если НЕ Параметры.Свойство("organization_ref") Тогда
		ВызватьИсключение "organization_ref is required";
	КонецЕсли;
	Если НЕ Параметры.Свойство("counterparty_ref") Тогда
		ВызватьИсключение "counterparty_ref is required";
	КонецЕсли;
	Если НЕ Параметры.Свойство("items") ИЛИ Параметры.items.Количество() = 0 Тогда
		ВызватьИсключение "items must contain at least one row";
	КонецЕсли;

	Организация = Справочники.Организации.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.organization_ref));
	Контрагент  = Справочники.Контрагенты.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.counterparty_ref));

	ДоговорСсылка = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Если Параметры.Свойство("contract_ref") И ЗначениеЗаполнено(Параметры.contract_ref) Тогда
		ДоговорСсылка = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(UUIDИзRefСтроки(Параметры.contract_ref));
	Иначе
		// Fallback: один существующий или типовое «Без договора».
		ДоговорСсылка = РазрешитьДоговорПоставщика(Контрагент, Организация);
	КонецЕсли;

	НомерВх = "";
	Если Параметры.Свойство("doc_number_in") Тогда НомерВх = СокрЛП(Строка(Параметры.doc_number_in)); КонецЕсли;
	ДатаВх = '00010101';
	Если Параметры.Свойство("doc_date_in") И ЗначениеЗаполнено(Параметры.doc_date_in) Тогда
		ДатаВх = ДатаИзСтрокиISO(Строка(Параметры.doc_date_in));
	КонецЕсли;
	СуммаДок = 0;
	Если Параметры.Свойство("amount") Тогда СуммаДок = ДробьИзПараметра(Параметры.amount); КонецЕсли;

	// Идемпотентность: (Контрагент + НомерВходящегоДокумента + ДатаВходящегоДокумента + СуммаДокумента).
	СуществующийРеф = НайтиСуществующееПоступление(Контрагент, НомерВх, ДатаВх, СуммаДок);
	Если ЗначениеЗаполнено(СуществующийРеф) Тогда
		Результат = Новый Структура;
		Результат.Вставить("success", Истина);
		Результат.Вставить("existing", Истина);
		Результат.Вставить("document", ДанныеПоступленияДляJSON(СуществующийРеф));
		Возврат Результат;
	КонецЕсли;

	Док = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
	Док.Дата = ?(ЗначениеЗаполнено(ДатаВх), ДатаВх, ТекущаяДатаСеанса());

	// ОбработкаЗаполнения(Структура("Контрагент"…, "ДоговорКонтрагента"…))
	// — это типовая точка БСП/Бух 3.0: подставит счета учёта расчётов с
	// контрагентом, способ зачёта авансов и прочие реквизиты согласно
	// настройкам организации и договора. Не вызывая её, мы бы сами
	// дублировали много типовой логики.
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Организация", Организация);
	ДанныеЗаполнения.Вставить("Контрагент", Контрагент);
	Если ЗначениеЗаполнено(ДоговорСсылка) Тогда
		ДанныеЗаполнения.Вставить("ДоговорКонтрагента", ДоговорСсылка);
	КонецЕсли;
	Док.Заполнить(ДанныеЗаполнения);

	// Заполнить может перетереть Организация/Контрагент/Договор — выставляем явно.
	Док.Организация = Организация;
	Док.Контрагент  = Контрагент;
	Если ЗначениеЗаполнено(ДоговорСсылка) Тогда
		Док.ДоговорКонтрагента = ДоговорСсылка;
	КонецЕсли;

	Док.НомерВходящегоДокумента = НомерВх;
	Док.ДатаВходящегоДокумента  = ДатаВх;
	Док.СуммаДокумента          = СуммаДок;

	Если Параметры.Свойство("vat_included") Тогда
		Док.СуммаВключаетНДС = Булево(Параметры.vat_included);
	Иначе
		Док.СуммаВключаетНДС = Истина;
	КонецЕсли;

	// УПД <-> ТОРГ-12 различие: УПД заменяет собой счёт-фактуру и накладную.
	Если Параметры.Свойство("is_universal_document") Тогда
		Док.ЭтоУниверсальныйДокумент = Булево(Параметры.is_universal_document);
	КонецЕсли;

	Если Параметры.Свойство("comment") Тогда
		Док.Комментарий = Строка(Параметры.comment);
	КонецЕсли;

	ЗаполнитьСтрокиТоваровПоступления(Док, Параметры.items);

	// Подтянуть счета учёта (СчетУчета, СчетУчетаНДС, СпособУчетаНДС) и
	// прочие зависимые поля строк через типовой helper Бух 3.0, который
	// читает РегистрСведений.СчетаУчетаНоменклатуры и аналогичные правила
	// определения счетов. Без этого вызова форма документа делает то же
	// самое в обработчике "Номенклатура.ПриИзменении", но при программном
	// заполнении строк форма не открывается.
	Попытка
		СчетаУчетаВДокументах.ЗаполнитьСтроки(Док.Товары, "Товары", Док, Документы.ПоступлениеТоваровУслуг);
	Исключение
		// Не блокируем запись — счета бухгалтер дозаполнит вручную.
	КонецПопытки;

	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Если Параметры.Свойство("post") И Булево(Параметры.post) Тогда
		РежимЗаписи = РежимЗаписиДокумента.Проведение;
	КонецЕсли;
	Док.Записать(РежимЗаписи);

	// Отметить «Оригинал получен» через типовую процедуру подсистемы учёта
	// оригиналов первичных документов. Для нашего сценария (загрузка скана)
	// по умолчанию считаем оригинал полученным; клиент может отключить
	// флагом original_received=false. Оборачиваем в Попытку — подсистема
	// может быть отключена функциональной опцией.
	ОригиналПолучен = Истина;
	Если Параметры.Свойство("original_received") Тогда
		ОригиналПолучен = Булево(Параметры.original_received);
	КонецЕсли;
	Если ОригиналПолучен Тогда
		Попытка
			ПоступлениеТоваровУслугФормыВызовСервера.ЗаписатьСтатусДокументаНаСервере(Док.Ссылка, Истина);
		Исключение
			// Подсистема учёта оригиналов недоступна — статус не критичен.
		КонецПопытки;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("success", Истина);
	Результат.Вставить("existing", Ложь);
	Результат.Вставить("document", ДанныеПоступленияДляJSON(Док.Ссылка));
	Возврат Результат;
КонецФункции

// Разрешить договор-fallback:
// 1) ищем единственный действующий «С поставщиком» у контрагента;
// 2) если ничего не нашли — вызываем типовой
//    РаботаСДоговорамиКонтрагентовБПВызовСервера.СоздатьОсновнойДоговорКонтрагента,
//    которая создаёт договор с наименованием «Без договора», помечает его
//    основным и привязывает к организации (это и есть эквивалент пункта
//    «Без договора» из dropdown'а на форме поступления).
Функция РазрешитьДоговорПоставщика(Контрагент, Организация)
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2 Дог.Ссылка КАК Ссылка
	|ИЗ Справочник.ДоговорыКонтрагентов КАК Дог
	|ГДЕ Дог.Владелец = &Контрагент
	|  И Дог.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)
	|  И НЕ Дог.ПометкаУдаления";
	З.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = З.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Первый = Выборка.Ссылка;
		Если НЕ Выборка.Следующий() Тогда
			// Ровно один — берём его.
			Возврат Первый;
		КонецЕсли;
		// Более одного — однозначный выбор невозможен.
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	// Договоров нет — создаём типовой «Без договора».
	ПараметрыДоговора = Новый Структура;
	ПараметрыДоговора.Вставить("Владелец",     Контрагент);
	ПараметрыДоговора.Вставить("Организация",  Организация);
	ПараметрыДоговора.Вставить("ВидДоговора",  Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	ПараметрыСоздания = Новый Структура("ЗначенияЗаполнения", ПараметрыДоговора);
	Попытка
		НовыйДоговор = РаботаСДоговорамиКонтрагентовБПВызовСервера.СоздатьОсновнойДоговорКонтрагента(ПараметрыСоздания);
		Если НовыйДоговор = Неопределено Тогда
			Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		КонецЕсли;
		Возврат НовыйДоговор;
	Исключение
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецПопытки;
КонецФункции

Функция НайтиСуществующееПоступление(Контрагент, НомерВх, ДатаВх, СуммаДок)
	Если НЕ ЗначениеЗаполнено(Контрагент) ИЛИ ПустаяСтрока(НомерВх) Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Сознательно ищем без СуммаДокумента: при записи Бух 3.0 пересчитывает
	// её из строк по правилу «сумма с НДС / без НДС» в зависимости от флага
	// СуммаВключаетНДС, поэтому сравнение payload-суммы с записанной даёт
	// ложноотрицательные срабатывания. Пара (Контрагент + НомерВх + ДатаВх)
	// у одного поставщика и без того уникальна.
	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Док.Ссылка КАК Ссылка
	|ИЗ Документ.ПоступлениеТоваровУслуг КАК Док
	|ГДЕ Док.Контрагент = &Контрагент
	|  И Док.НомерВходящегоДокумента = &НомерВх
	|  И Док.ДатаВходящегоДокумента = &ДатаВх";
	З.УстановитьПараметр("Контрагент", Контрагент);
	З.УстановитьПараметр("НомерВх",   НомерВх);
	З.УстановитьПараметр("ДатаВх",    ДатаВх);
	Выборка = З.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ЗаполнитьСтрокиТоваровПоступления(Док, СтрокиИзПараметров)
	Док.Товары.Очистить();
	Для Каждого СтрокаПараметра Из СтрокиИзПараметров Цикл
		Если НЕ СтрокаПараметра.Свойство("nomenclature_ref") Тогда
			ВызватьИсключение "items[*].nomenclature_ref is required";
		КонецЕсли;
		НомСсылка = Справочники.Номенклатура.ПолучитьСсылку(UUIDИзRefСтроки(СтрокаПараметра.nomenclature_ref));

		НоваяСтрока = Док.Товары.Добавить();
		НоваяСтрока.Номенклатура = НомСсылка;
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор();

		Если СтрокаПараметра.Свойство("quantity") Тогда
			НоваяСтрока.Количество = ДробьИзПараметра(СтрокаПараметра.quantity);
		Иначе
			НоваяСтрока.Количество = 1;
		КонецЕсли;
		Если СтрокаПараметра.Свойство("price") Тогда
			НоваяСтрока.Цена = ДробьИзПараметра(СтрокаПараметра.price);
		КонецЕсли;
		Если СтрокаПараметра.Свойство("amount") Тогда
			НоваяСтрока.Сумма = ДробьИзПараметра(СтрокаПараметра.amount);
		Иначе
			НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
		КонецЕсли;
		Если СтрокаПараметра.Свойство("vat_rate") Тогда
			НоваяСтрока.СтавкаНДС = СтавкаНДСИзСтроки(СтрокаПараметра.vat_rate);
		КонецЕсли;
		Если СтрокаПараметра.Свойство("vat_amount") Тогда
			НоваяСтрока.СуммаНДС = ДробьИзПараметра(СтрокаПараметра.vat_amount);
		Иначе
			// Если НДС не передан явно — даём типовому хелперу пересчитать
			// с учётом признака «сумма включает НДС».
			ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, Док.СуммаВключаетНДС);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СтавкаНДСИзСтроки(Знач Значение)
	Норм = ВРег(СтрЗаменить(СокрЛП(Строка(Значение)), " ", ""));
	Если Норм = "20" ИЛИ Норм = "НДС20" Тогда
		Возврат Перечисления.СтавкиНДС.НДС20;
	ИначеЕсли Норм = "10" ИЛИ Норм = "НДС10" Тогда
		Возврат Перечисления.СтавкиНДС.НДС10;
	ИначеЕсли Норм = "0" ИЛИ Норм = "НДС0" Тогда
		Возврат Перечисления.СтавкиНДС.НДС0;
	ИначеЕсли Норм = "18" ИЛИ Норм = "НДС18" Тогда
		Возврат Перечисления.СтавкиНДС.НДС18;
	ИначеЕсли Норм = "20/120" ИЛИ Норм = "НДС20_120" Тогда
		Возврат Перечисления.СтавкиНДС.НДС20_120;
	ИначеЕсли Норм = "10/110" ИЛИ Норм = "НДС10_110" Тогда
		Возврат Перечисления.СтавкиНДС.НДС10_110;
	ИначеЕсли Норм = "18/118" ИЛИ Норм = "НДС18_118" Тогда
		Возврат Перечисления.СтавкиНДС.НДС18_118;
	ИначеЕсли Норм = "БЕЗНДС" ИЛИ Норм = "БЕЗ_НДС" ИЛИ Норм = "" Тогда
		Возврат Перечисления.СтавкиНДС.БезНДС;
	КонецЕсли;
	Возврат Перечисления.СтавкиНДС.НДС20;
КонецФункции

Функция ДробьИзПараметра(Знач Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Строка = СтрЗаменить(СтрЗаменить(СокрЛП(Строка(Значение)), ",", "."), " ", "");
	Попытка
		Возврат Число(Строка);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция ДатаИзСтрокиISO(Знач Строка)
	// Принимаем "YYYY-MM-DD" или "YYYY-MM-DDTHH:MM:SS"; всё остальное — пустая дата.
	Если СтрДлина(Строка) < 10 Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Год    = Число(Сред(Строка, 1, 4));
		Месяц  = Число(Сред(Строка, 6, 2));
		День   = Число(Сред(Строка, 9, 2));
		Возврат Дата(Год, Месяц, День);
	Исключение
		Возврат '00010101';
	КонецПопытки;
КонецФункции

Функция ДанныеПоступленияДляJSON(ДокументСсылка)
	Док = ДокументСсылка.ПолучитьОбъект();
	Данные = Новый Структура;
	Данные.Вставить("ref",          СтрокаТипизированнойСсылки(Док.Ссылка));
	Данные.Вставить("number",       Док.Номер);
	Данные.Вставить("date",         Строка(Док.Дата));
	Данные.Вставить("organization", Строка(Док.Организация));
	Данные.Вставить("counterparty", Строка(Док.Контрагент));
	Данные.Вставить("contract",     Строка(Док.ДоговорКонтрагента));
	Данные.Вставить("amount",       Строка(Док.СуммаДокумента));
	Данные.Вставить("posted",       Док.Проведен);
	Данные.Вставить("doc_number_in", Строка(Док.НомерВходящегоДокумента));
	Данные.Вставить("doc_date_in",   Строка(Док.ДатаВходящегоДокумента));
	Возврат Данные;
КонецФункции

#КонецОбласти

#КонецОбласти
