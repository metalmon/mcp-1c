		|ГДЕ
		|	(" + ТекстУсловий + ")";
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + "
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата УБЫВ";

	ЗапросСписка.Текст = ТекстЗапроса;
	Выборка = ЗапросСписка.Выполнить().Выбрать();

