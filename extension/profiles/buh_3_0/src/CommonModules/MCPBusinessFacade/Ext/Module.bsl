Функция ПрочитатьДокументыПродаж(Параметры, ИмяТаблицыДокумента, ИмяМассиваВОтвете) Экспорт
	Лимит = НормализоватьЛимит(Параметры, 50, 500);
	ЗапросСписка = Новый Запрос;
	ЗапросСписка.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ref,
	|	Док.Номер КАК Number,
	|	Док.Дата КАК Date,
	|	Док.Проведен КАК Posted
	|ИЗ
	|	" + ИмяТаблицыДокумента + " КАК Док
	|УПОРЯДОЧИТЬ ПО Док.Дата УБЫВ";
	Выборка = ЗапросСписка.Выполнить().Выбрать();

	МассивДокументов = Новый Массив;
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Если Счетчик = Лимит Тогда
			Прервать;
		КонецЕсли;
		Стр = Новый Структура;
		Стр.Вставить("ref", СсылкаВUUIDСтроку(Выборка.Ref));
		Стр.Вставить("number", Строка(Выборка.Number));
		Стр.Вставить("date", Строка(Выборка.Date));
		Стр.Вставить("posted", Выборка.Posted);
		МассивДокументов.Добавить(Стр);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить(ИмяМассиваВОтвете, МассивДокументов);
	Результат.Вставить("total", МассивДокументов.Количество());
	Результат.Вставить("truncated", Ложь);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьСправочник(ИмяТаблицы, ИмяМассива, Параметры, ИмяПоляСортировки, ДопПоля)
	Лимит = НормализоватьЛимит(Параметры, 50, 500);
	ЗапросСписка = Новый Запрос;
	ЗапросСписка.Текст =
	"ВЫБРАТЬ
	|	Ссылка КАК Ref,
	|	Код КАК Code,
	|	Наименование КАК Name
	|ИЗ
	|	" + ИмяТаблицы + "
	|УПОРЯДОЧИТЬ ПО " + ИмяПоляСортировки;
	Выборка = ЗапросСписка.Выполнить().Выбрать();

	Коллекция = Новый Массив;
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Если Счетчик = Лимит Тогда
			Прервать;
		КонецЕсли;
		Стр = Новый Структура;
		Стр.Вставить("ref", СсылкаВUUIDСтроку(Выборка.Ref));
		Стр.Вставить("code", Строка(Выборка.Code));
		Стр.Вставить("name", Строка(Выборка.Name));
		Коллекция.Добавить(Стр);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить(ИмяМассива, Коллекция);
	Результат.Вставить("total", Коллекция.Количество());
	Результат.Вставить("truncated", Ложь);
	Возврат Результат;
КонецФункции

Функция НормализоватьЛимит(Параметры, ЗначениеПоУмолчанию, Максимум)
	Лимит = ЗначениеПоУмолчанию;
	Если Параметры.Свойство("limit") Тогда
		Попытка
			Лимит = Число(Параметры.limit);
		Исключение
			Лимит = ЗначениеПоУмолчанию;
		КонецПопытки;
	КонецЕсли;
	Если Лимит <= 0 Тогда
		Лимит = ЗначениеПоУмолчанию;
	ИначеЕсли Лимит > Максимум Тогда
		Лимит = Максимум;
	КонецЕсли;
	Возврат Лимит;
КонецФункции

Функция UUIDИзСтроки(ЗначениеUUID)
	Попытка
		Возврат Новый УникальныйИдентификатор(Строка(ЗначениеUUID));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ДатаИзСтроки(ЗначениеДаты)
	Попытка
		Возврат XMLЗначение(Тип("Дата"), ЗначениеДаты);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция СсылкаВUUIDСтроку(Ссылка)
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Строка(Ссылка.УникальныйИдентификатор());
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Процедура ПроверитьСуществованиеСсылки(Ссылка, ИмяПоля)
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение ИмяПоля + " is empty";
	КонецЕсли;
	Попытка
		ОбъектСсылки = Ссылка.ПолучитьОбъект();
		Если ОбъектСсылки = Неопределено Тогда
			ВызватьИсключение ИмяПоля + " not found";
		КонецЕсли;
		Попытка
			Если ОбъектСсылки.ПометкаУдаления Тогда
				ВызватьИсключение ИмяПоля + " points to deleted object";
			КонецЕсли;
		Исключение
		КонецПопытки;
	Исключение
		ВызватьИсключение ИмяПоля + " not found";
	КонецПопытки;
КонецПроцедуры

Функция ДанныеСсылкиДляJSON(Ссылка)
	Объект = Ссылка.ПолучитьОбъект();
	Данные = Новый Структура;
	Данные.Вставить("ref", СсылкаВUUIDСтроку(Ссылка));
	Код = "";
	Наименование = "";
	Попытка
		Код = Объект.Код;
	Исключение
	КонецПопытки;
	Попытка
		Наименование = Объект.Наименование;
	Исключение
	КонецПопытки;
	Данные.Вставить("code", Код);
	Данные.Вставить("name", Наименование);
	Возврат Данные;
КонецФункции

Функция ПолучитьСсылкуДокументаПродаж(ТипДокумента, RefСтрока)
	Если ТипДокумента = "СчетНаОплатуПокупателю" Тогда
		Возврат Документы.СчетНаОплатуПокупателю.ПолучитьСсылку(UUIDИзСтроки(RefСтрока));
	КонецЕсли;
	Возврат Документы.РеализацияТоваровУслуг.ПолучитьСсылку(UUIDИзСтроки(RefСтрока));
КонецФункции

Функция ПолучитьСсылкуДокументаПоUUID(RefСтрока)
	UUIDДокумента = UUIDИзСтроки(RefСтрока);
	Если UUIDДокумента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого ДокументМД Из Метаданные.Документы Цикл
		Попытка
			СсылкаДок = Документы[ДокументМД.Имя].ПолучитьСсылку(UUIDДокумента);
			Если ЗначениеЗаполнено(СсылкаДок) Тогда
				Попытка
					СсылкаДок.ПолучитьОбъект();
					Возврат СсылкаДок;
				Исключение
				КонецПопытки;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьМодульРаботыСФайлами()
	Попытка
		Возврат ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция СформироватьИмяВложения(ДокументСсылка, ИсходноеИмя)
	Расширение = "pdf";
	БазовоеИмя = "";
	Если ЗначениеЗаполнено(ИсходноеИмя) Тогда
		Попытка
			ФайлИсходный = Новый Файл(ИсходноеИмя);
			Если ЗначениеЗаполнено(ФайлИсходный.ИмяБезРасширения) Тогда
				БазовоеИмя = ФайлИсходный.ИмяБезРасширения;
			КонецЕсли;
			Если ЗначениеЗаполнено(ФайлИсходный.Расширение) Тогда
				Расширение = НРег(ФайлИсходный.Расширение);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если ПустаяСтрока(БазовоеИмя) Тогда
		БазовоеИмя = "attachment";
	КонецЕсли;

	Попытка
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		ТипДок = ДокументСсылка.Метаданные().Имя;
		НомерДок = Строка(ДокОбъект.Номер);
		ДатаДок = Формат(ДокОбъект.Дата, "ДФ=yyyyMMdd");
	Исключение
		ТипДок = "Документ";
		НомерДок = "";
		ДатаДок = Формат(ТекущаяДата(), "ДФ=yyyyMMdd");
	КонецПопытки;

	Возврат ТипДок + "_" + НомерДок + "_" + ДатаДок + "_" + БазовоеИмя + "." + Расширение;
КонецФункции

Функция ПолучитьСписокВложенийДокумента(ДокументСсылка)
	МодульРаботаСФайлами = ПолучитьМодульРаботыСФайлами();
	Если МодульРаботаСФайлами = Неопределено Тогда
		ВызватьИсключение "document attachments are not supported: РаботаСФайлами module is unavailable";
	КонецЕсли;
	Если НЕ МодульРаботаСФайлами.КОбъектуМожноПрисоединятьФайлы(ДокументСсылка) Тогда
		ВызватьИсключение "files cannot be attached to this document";
	КонецЕсли;

	КоллекцияФайлов = Неопределено;
	Попытка
		КоллекцияФайлов = МодульРаботаСФайлами.ПрисоединенныеФайлы(ДокументСсылка);
	Исключение
	КонецПопытки;
	Если КоллекцияФайлов = Неопределено Тогда
		Попытка
			КоллекцияФайлов = МодульРаботаСФайлами.ФайлыОбъекта(ДокументСсылка);
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если КоллекцияФайлов = Неопределено Тогда
		ВызватьИсключение "document attachments listing is not supported by current 1C profile";
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Элемент Из КоллекцияФайлов Цикл
		СсылкаФайла = ИзвлечьСсылкуФайла(Элемент);
		Если ЗначениеЗаполнено(СсылкаФайла) Тогда
			Результат.Добавить(ПреобразоватьВложениеВJSON(СсылкаФайла));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьСсылкуПрисоединенногоФайла(RefСтрока)
	UUIDФайла = UUIDИзСтроки(RefСтрока);
	Если UUIDФайла = Неопределено Тогда
		ВызватьИсключение "attachment_ref is invalid";
	КонецЕсли;
	Попытка
		Ссылка = Справочники.ПрисоединенныеФайлы.ПолучитьСсылку(UUIDФайла);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Ссылка = Справочники.Файлы.ПолучитьСсылку(UUIDФайла);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	ВызватьИсключение "attachment_ref not found";
КонецФункции

Функция ИзвлечьСсылкуФайла(Элемент)
	Если ТипЗнч(Элемент) = Тип("СправочникСсылка.ПрисоединенныеФайлы") ИЛИ ТипЗнч(Элемент) = Тип("СправочникСсылка.Файлы") Тогда
		Возврат Элемент;
	КонецЕсли;
	Попытка
		Если ЗначениеЗаполнено(Элемент.Ссылка) Тогда
			Возврат Элемент.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Если ЗначениеЗаполнено(Элемент.Файл) Тогда
			Возврат Элемент.Файл;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Если ЗначениеЗаполнено(Элемент.ФайлСсылка) Тогда
			Возврат Элемент.ФайлСсылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьДвоичныеДанныеВложения(СсылкаФайла)
	МодульРаботаСФайлами = ПолучитьМодульРаботыСФайлами();
	Если МодульРаботаСФайлами <> Неопределено Тогда
		Попытка
			Возврат МодульРаботаСФайлами.ПолучитьДвоичныеДанныеФайла(СсылкаФайла);
		Исключение
		КонецПопытки;
		Попытка
			Возврат МодульРаботаСФайлами.ДвоичныеДанныеФайла(СсылкаФайла);
		Исключение
		КонецПопытки;
	КонецЕсли;

	ФайлОбъект = СсылкаФайла.ПолучитьОбъект();
	Попытка
		Возврат ФайлОбъект.ХранилищеФайла.Получить();
	Исключение
	КонецПопытки;
	Попытка
		Возврат ФайлОбъект.ДвоичныеДанныеФайла;
	Исключение
	КонецПопытки;
	ВызватьИсключение "attachment content read is not supported by current 1C profile";
КонецФункции

Функция ПреобразоватьВложениеВJSON(СсылкаФайла)
	ФайлОбъект = СсылкаФайла.ПолучитьОбъект();
	Данные = Новый Структура;
	Данные.Вставить("ref", СсылкаВUUIDСтроку(СсылкаФайла));
	Данные.Вставить("document_ref", "");
	Данные.Вставить("file_name", "");
	Данные.Вставить("description", "");
	Данные.Вставить("mime_type", "");
	Данные.Вставить("size_bytes", 0);
	Данные.Вставить("created_at", "");

	Попытка
		Данные.document_ref = СсылкаВUUIDСтроку(ФайлОбъект.ВладелецФайла);
	Исключение
	КонецПопытки;
	Попытка
		Данные.file_name = Строка(ФайлОбъект.Наименование);
	Исключение
	КонецПопытки;
	Попытка
		Данные.description = Строка(ФайлОбъект.Описание);
	Исключение
		Попытка
			Данные.description = Строка(ФайлОбъект.Комментарий);
		Исключение
		КонецПопытки;
	КонецПопытки;
	Попытка
		Данные.mime_type = Строка(ФайлОбъект.ТипMIME);
	Исключение
	КонецПопытки;
	Попытка
		Данные.size_bytes = Число(ФайлОбъект.Размер);
	Исключение
	КонецПопытки;
	Попытка
		Данные.created_at = Строка(ФайлОбъект.ДатаСоздания);
	Исключение
	КонецПопытки;
	Возврат Данные;
КонецФункции

Процедура ЗаполнитьТоварыДокументаПродаж(Док, Параметры, Пост, ЗаменитьСуществующие)
	Если Пост И (НЕ Параметры.Свойство("items") ИЛИ ТипЗнч(Параметры.items) <> Тип("Массив") ИЛИ Параметры.items.Количество() = 0) Тогда
		Если НЕ ЗаменитьСуществующие ИЛИ Док.Товары.Количество() = 0 Тогда
			ВызватьИсключение "items are required when post=true";
		КонецЕсли;
	КонецЕсли;

	Если Параметры.Свойство("items") И ТипЗнч(Параметры.items) = Тип("Массив") Тогда
		Если ЗаменитьСуществующие Тогда
			Док.Товары.Очистить();
		КонецЕсли;
		НомерСтроки = 0;
		Для Каждого СтрТов Из Параметры.items Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НЕ СтрТов.Свойство("nomenclature_ref") Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].nomenclature_ref is required";
			КонецЕсли;
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(UUIDИзСтроки(СтрТов.nomenclature_ref));
			Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].nomenclature_ref not found";
			КонецЕсли;
			ПроверитьСуществованиеСсылки(Номенклатура, "items[" + Строка(НомерСтроки) + "].nomenclature_ref");
			СтрокаТЧ = Док.Товары.Добавить();
			СтрокаТЧ.Номенклатура = Номенклатура;
			Если Пост И НЕ СтрТов.Свойство("quantity") Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].quantity is required when post=true";
			КонецЕсли;
			Если Пост И НЕ СтрТов.Свойство("price") Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].price is required when post=true";
			КонецЕсли;
			Если СтрТов.Свойство("quantity") Тогда СтрокаТЧ.Количество = Число(СтрТов.quantity); Иначе СтрокаТЧ.Количество = 1; КонецЕсли;
			Если СтрТов.Свойство("price") Тогда СтрокаТЧ.Цена = Число(СтрТов.price); КонецЕсли;
			Если Пост И СтрокаТЧ.Количество <= 0 Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].quantity must be > 0 when post=true";
			КонецЕсли;
			Если Пост И СтрокаТЧ.Цена <= 0 Тогда
				ВызватьИсключение "items[" + Строка(НомерСтроки) + "].price must be > 0 when post=true";
			КонецЕсли;
			Попытка
				ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТЧ, Док, "Товары", Док.Метаданные());
			Исключение
			КонецПопытки;
			Если НЕ СтрТов.Свойство("quantity") Тогда
				СтрокаТЧ.Количество = 1;
			КонецЕсли;
			ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуТабЧасти(СтрокаТЧ);
			ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтрокаТЧ, Док.СуммаВключаетНДС);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
