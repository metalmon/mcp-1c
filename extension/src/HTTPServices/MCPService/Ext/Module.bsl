Функция ЗаписатьДокументПродаж(ЗапросHTTP, ТипДокумента)
    Параметры = РазобратьJSON(ЗапросHTTP.ПолучитьТелоКакСтроку());
    Если Параметры = Неопределено Тогда
        Возврат ОтветОшибка(400, "Invalid request body");
    КонецЕсли;

    Попытка
        Если Параметры.Свойство("ref") И ЗначениеЗаполнено(Параметры.ref) Тогда
            РезультатЗаписи = MCPBusinessFacade.ОбновитьДокументПродаж(Параметры, ТипДокумента);
        Иначе
            РезультатЗаписи = MCPBusinessFacade.СоздатьДокументПродаж(Параметры, ТипДокумента);
        КонецЕсли;
    Исключение
        Возврат ОтветОшибка(400, ОписаниеОшибки());
    КонецПопытки;

    Если НЕ РезультатЗаписи.Свойство("ref") Тогда
        Возврат ОтветОшибка(500, "invalid sales document write result: ref is missing");
    КонецЕсли;
    
    ДокументСсылка = ПолучитьСсылкуДокументаПродажПоRef(ТипДокумента, РезультатЗаписи.ref);
    Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
        Возврат ОтветОшибка(500, "invalid sales document write result: ref is invalid");
    КонецЕсли;
    
    Результат = Новый Структура;
    Результат.Вставить("success", Истина);
    Результат.Вставить("document", ДанныеДокументаПродажДляJSON(ДокументСсылка));
    Возврат ОтветJSON(Результат);
КонецФункции

